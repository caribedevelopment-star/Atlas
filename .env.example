# Configuración pública necesaria para que Atlas conecte con Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: activa los datos de demostración locales.
NEXT_PUBLIC_ATLAS_DEMO=false

# Opcional: Can.ia y la asistencia de descripciones funcionan en modo local sin esta clave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
